  <!-- MODAL LIGHTBOX PARA AMPLIAR IMÁGENES Y VIDEOS SHORTS -->
  <div id="portfolioModal" class="modal-overlay">
    <div class="modal-content" id="modalContent">
      <button class="modal-close" aria-label="Cerrar vista previa">&times;</button>
      <div class="modal-img-stage">
        <button type="button" class="modal-nav-btn prev" id="modalPrevBtn" aria-label="Anterior">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <img id="modalImage" src="" alt="" />
        <button type="button" class="modal-nav-btn next" id="modalNextBtn" aria-label="Siguiente">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>
      <div class="modal-video-stage">
        <iframe
          id="modalVideoFrame"
          src=""
          title="Video en pantalla completa"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
        ></iframe>
      </div>
      <p id="modalTitle"></p>
      <div id="modalCounter" class="modal-counter"></div>
    </div>
  </div>

  <!-- 6. FOOTER ESTÁTICO CON LOGO Y ENLACE A RAÍZ -->
  <footer class="footer-mc fondo-acento2">
    <a href="/" class="footer-logo-link" title="yaga.haus 2026 - Ir al inicio">
      <img src="/assets/logo/logo.svg" alt="yaga.haus 2026" />
    </a>
  </footer>

  <!-- SCRIPTS DE INTERACCIÓN -->
  <script>
    // 1. Navbar: Compresión al hacer scroll + Menú Hamburguesa
    const navbarWrapper = document.getElementById('navbarWrapper');
    const heroPhotoFrame = document.getElementById('heroPhotoFrame');
    const hamburgerBtn = document.getElementById('hamburgerBtn');
    const mobileDrawer = document.getElementById('mobileDrawer');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    const handleNavbarScroll = () => {
      const triggerPoint = heroPhotoFrame
        ? Math.max(60, heroPhotoFrame.getBoundingClientRect().top + window.scrollY - 90)
        : 90;

      if (window.scrollY > triggerPoint) {
        navbarWrapper?.classList.add('scrolled');
      } else {
        navbarWrapper?.classList.remove('scrolled');
        if (window.innerWidth > 860) {
          mobileDrawer?.classList.remove('open');
          hamburgerBtn?.setAttribute('aria-expanded', 'false');
        }
      }
    };

    window.addEventListener('scroll', handleNavbarScroll, { passive: true });
    handleNavbarScroll();

    hamburgerBtn?.addEventListener('click', () => {
      const isOpen = mobileDrawer?.classList.toggle('open');
      hamburgerBtn.setAttribute('aria-expanded', String(isOpen));
    });

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileDrawer?.classList.remove('open');
        hamburgerBtn?.setAttribute('aria-expanded', 'false');
      });
    });

    // 2. Acordeón / Pestañas interactivas de Soluciones
    const solucionTriggers = document.querySelectorAll('.solucion-pill');
    const solucionPanels = document.querySelectorAll('.solucion-panel');

    solucionTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const targetId = trigger.getAttribute('data-target');
        const targetPanel = targetId ? document.getElementById(targetId) : null;
        const isAlreadyActive = trigger.classList.contains('active');

        solucionTriggers.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('aria-expanded', 'false');
        });
        solucionPanels.forEach(panel => panel.classList.remove('active'));

        if (!isAlreadyActive && targetPanel) {
          trigger.classList.add('active');
          trigger.setAttribute('aria-expanded', 'true');
          targetPanel.classList.add('active');
        }
      });
    });

    // 3. Filtros de Categoría en Portafolio (Todos / Videos / Imagen y Estrategia)
    const filterButtons = document.querySelectorAll('.filtro-btn');
    const portfolioCards = document.querySelectorAll('.portafolio-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const selectedFilter = btn.getAttribute('data-filter') || 'todos';

        filterButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        portfolioCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          const shouldShow = selectedFilter === 'todos' || cardCategory === selectedFilter;
          card.classList.toggle('is-hidden', !shouldShow);
        });
      });
    });

    // 4. Lightbox Modal con navegación entre fotos y vista vertical para Shorts
    const modal = document.getElementById('portfolioModal');
    const modalContent = document.getElementById('modalContent');
    const modalImg = document.getElementById('modalImage') as HTMLImageElement;
    const modalVideoFrame = document.getElementById('modalVideoFrame') as HTMLIFrameElement;
    const modalTitle = document.getElementById('modalTitle');
    const modalCounter = document.getElementById('modalCounter');
    const modalPrevBtn = document.getElementById('modalPrevBtn');
    const modalNextBtn = document.getElementById('modalNextBtn');
    const closeBtn = document.querySelector('.modal-close');

    let currentModalImages: string[] = [];
    let currentModalIndex = 0;

    const renderModalImage = () => {
      if (!modalImg || currentModalImages.length === 0) return;
      modalImg.src = currentModalImages[currentModalIndex];
      const hasMany = currentModalImages.length > 1;
      modalPrevBtn?.classList.toggle('hidden', !hasMany);
      modalNextBtn?.classList.toggle('hidden', !hasMany);
      if (modalCounter) {
        modalCounter.textContent = hasMany ? `${currentModalIndex + 1} / ${currentModalImages.length}` : '';
      }
    };

    const openLightbox = (images: string[], startIndex: number, title: string) => {
      modalContent?.classList.remove('is-video-mode');
      if (modalVideoFrame) modalVideoFrame.src = '';
      currentModalImages = images;
      currentModalIndex = startIndex;
      if (modalTitle) modalTitle.textContent = title;
      renderModalImage();
      modal?.classList.add('active');
      document.body.style.overflow = 'hidden';
    };

    const openVideoLightbox = (youtubeId: string, title: string) => {
      modalContent?.classList.add('is-video-mode');
      if (modalVideoFrame) {
        modalVideoFrame.src = `https://www.youtube.com/embed/${youtubeId}?autoplay=1&rel=0`;
      }
      if (modalTitle) modalTitle.textContent = title;
      if (modalCounter) modalCounter.textContent = '';
      modal?.classList.add('active');
      document.body.style.overflow = 'hidden';
    };

    modalPrevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentModalIndex = (currentModalIndex - 1 + currentModalImages.length) % currentModalImages.length;
      renderModalImage();
    });

    modalNextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      currentModalIndex = (currentModalIndex + 1) % currentModalImages.length;
      renderModalImage();
    });

    const closeModal = () => {
      modal?.classList.remove('active');
      modalContent?.classList.remove('is-video-mode');
      if (modalVideoFrame) modalVideoFrame.src = '';
      document.body.style.overflow = 'auto';
    };

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('active')) return;
      if (e.key === 'Escape') closeModal();
      if (!modalContent?.classList.contains('is-video-mode') && currentModalImages.length > 1) {
        if (e.key === 'ArrowLeft') {
          currentModalIndex = (currentModalIndex - 1 + currentModalImages.length) % currentModalImages.length;
          renderModalImage();
        }
        if (e.key === 'ArrowRight') {
          currentModalIndex = (currentModalIndex + 1) % currentModalImages.length;
          renderModalImage();
        }
      }
    });

    // Disparadores para tarjetas de 1 sola imagen
    document.querySelectorAll('.portafolio-img-trigger').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const images = JSON.parse(trigger.getAttribute('data-images') || '[]');
        const title = trigger.getAttribute('data-title') || '';
        openLightbox(images, 0, title);
      });
    });

    // Disparadores para ampliar Shorts en móvil
    document.querySelectorAll('.short-expand-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const youtubeId = btn.getAttribute('data-youtube-id') || '';
        const title = btn.getAttribute('data-title') || '';
        if (youtubeId) openVideoLightbox(youtubeId, title);
      });
    });

    // 5. Carrusel con Autoplay para entradas con múltiples fotos
    document.querySelectorAll('.mc-carousel').forEach((carousel) => {
      const track = carousel.querySelector('.mc-carousel-track') as HTMLElement;
      const slides = carousel.querySelectorAll('.mc-carousel-slide');
      const dots = carousel.querySelectorAll('.carousel-dot');
      const counter = carousel.querySelector('.carousel-counter');
      const prevBtn = carousel.querySelector('.carousel-arrow.prev');
      const nextBtn = carousel.querySelector('.carousel-arrow.next');
      const images: string[] = JSON.parse(carousel.getAttribute('data-images') || '[]');
      const title = carousel.getAttribute('data-title') || '';

      let activeIndex = 0;
      let autoplayTimer: number | undefined;

      const goToSlide = (index: number) => {
        activeIndex = (index + slides.length) % slides.length;
        if (track) track.style.transform = `translateX(-${activeIndex * 100}%)`;
        dots.forEach((dot, i) => dot.classList.toggle('active', i === activeIndex));
        if (counter) counter.textContent = `${activeIndex + 1} / ${slides.length}`;
      };

      const startAutoplay = () => {
        stopAutoplay();
        autoplayTimer = window.setInterval(() => goToSlide(activeIndex + 1), 3800);
      };

      const stopAutoplay = () => {
        if (autoplayTimer) clearInterval(autoplayTimer);
      };

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(activeIndex - 1);
        startAutoplay();
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(activeIndex + 1);
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = Number(dot.getAttribute('data-slide-to') || 0);
          goToSlide(idx);
          startAutoplay();
        });
      });

      slides.forEach((slide) => {
        slide.addEventListener('click', () => {
          const idx = Number(slide.getAttribute('data-index') || 0);
          openLightbox(images, idx, title);
        });
      });

      carousel.addEventListener('mouseenter', stopAutoplay);
      carousel.addEventListener('mouseleave', startAutoplay);

      startAutoplay();
    });
  </script>

</body>
</html>
